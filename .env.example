# Server Port
PORT=3000
NODE_ENV=development

# Local Open-Weight Model (Ollama)
# When running locally, install Ollama (https://ollama.ai) and run:
# ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cloud Open-Weight Model Fallback (For Render deployment or remote demo)
# Using open-weight Llama 3.1 via Groq free tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Backboard.io Persistent Memory & Session Telemetry (Optional)
# Claim your $5 credit from hacktoberfest.com/my or backboard.io
BACKBOARD_API_KEY=
BACKBOARD_PROJECT_ID=freelanceforge-default
